# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser,
# because Row Level Security only allows reads.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — FULL database access, bypasses RLS.
# Server-side only (pipeline + API routes). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS webhook (httpsms.com) ──────────────────────────────────────────────
# Shared secret appended to the callback URL (?token=...) so only your
# httpsms webhook can post reports. Generate: openssl rand -hex 32
# (Variable name is a holdover from an earlier Africa's Talking integration —
# it's just the generic SMS-webhook secret now.)
AT_WEBHOOK_SECRET=

# HMAC key used to hash reporter phone numbers before storage.
# Raw phone numbers are never persisted. Generate: openssl rand -hex 32
REPORT_HASH_KEY=

# ── Earth Engine pipeline ─────────────────────────────────────────────────
# Google Cloud project registered for Earth Engine (noncommercial tier).
EE_PROJECT=

# Optional — only needed for scheduled/CI runs (GitHub Actions), where
# there's no browser for `earthengine authenticate`'s interactive login.
# Leave both blank for local/manual runs; a Google service account with
# Earth Engine access is used instead when both are set. See
# .github/workflows/drain-pipeline-queue.yml and README's "Automating the
# scan queue" section for how to create one.
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY=

# Optional risk multiplier from gold price trend (1.0 = neutral).
GOLD_TREND_MULTIPLIER=1.0
